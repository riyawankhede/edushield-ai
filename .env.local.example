# ==============================================================================
# EduShield AI — Local Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is listed in .gitignore.
# ==============================================================================

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Next.js Application URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-minimum-32-chars

# JWT Signing Secrets (server-side only — never expose to client)
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-minimum-32-chars

# Google Gemini API (Server-side only — never expose to client!)
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Python FastAPI ML Microservice URL & API Key
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=replace-with-your-ml-service-api-key

# Public App Metadata (safe to expose to the browser)
NEXT_PUBLIC_APP_NAME="EduShield AI"
NEXT_PUBLIC_SCHOOL_NAME="Greenfield Academy"
